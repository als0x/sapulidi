#!/bin/sh
# Fake go for test_release.sh: answers "go env GOVERSION" from the toolchain line of go.mod and logs, at every
# "go build", the version that bin/sapulidi and .claude-plugin/plugin.json carry and whether checksums.txt exists.
case $1 in
env)
	sed -n 's/^toolchain //p' go.mod
	;;
build)
	out=
	while [ $# -gt 0 ]; do
		[ "$1" != -o ] || out=$2
		shift
	done
	# FAKE_FAIL_BUILD=N makes the Nth build call fail.
	done_builds=$(grep -c '^build' "$FAKE_LOG")
	if [ "${FAKE_FAIL_BUILD:-0}" = $((done_builds + 1)) ]; then
		echo "fake go: build $((done_builds + 1)) fails" >&2
		exit 1
	fi
	launcher=$(sed -n 's/^SAPULIDI_VERSION=//p' bin/sapulidi)
	manifest=$(sed -n 's/.*"version": "\([^"]*\)".*/\1/p' .claude-plugin/plugin.json)
	sums=$(cksum <checksums.txt | tr ' ' :)
	echo "build launcher=$launcher manifest=$manifest checksums=$sums" >>"$FAKE_LOG"
	echo "fake binary $launcher" >"$out"
	;;
esac
